<% layout("/layouts/boilerplate")%>


    <body>

        <h1>All Listings</h1>
        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
            <% for (let list of listings) { %>
            <a href="/listings/<%= list._id %>" class="listing-link">
                <div class="card col" >
                <img src="<%=list.image.url%>" 
                    class="card-img-top" 
                    alt="<%=list.image.filename%>" 
                    style="height: 20rem ">
                <div class="card-img-overlay">
                 </div>
                <div class="card-body">
                    <p class="card-text">
                        <b><%=list.title%></b> <br>
                        Price:</b> &#x20B9;<%=list.price.toLocaleString("en-IN")%>/nigth
                    </p>
                </div>
            </div>
            </a>
            <%}%>
        </div>

        <!-- <form method="GET" action="/listings/new">
    <button>Add New Listing</button>
</form> -->

    </body>


