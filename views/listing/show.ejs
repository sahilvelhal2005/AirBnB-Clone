    <h1><%=details.title%></h1>
    <p><%=details.description%></p>
    <img src="<%=details.image.url%>" alt="<%=details.image.filename%>">
    <h3><b>Price:</b> &#x20B9;<%=details.price.toLocaleString("en-IN")%></h3>
    <h3><b>Location:</b> <%=details.location%></h3>
    <h3><b>Country:</b> <%=details.country%></h3>

    <form method="POST" action="/listings/<%=details._id%>?_method=DELETE">
        <button>Delete</button>
    </form>
    <form method="GET" action="/listings/<%=details._id%>/edit">
        <button>Edit</button>
    </form>

    </div>
</div>
